      "item": [
        {
          "id": "5ff14abb-ed74-405f-830e-3ee15847f488",
          "name": "Upload an application build",
          "request": {
            "name": "Upload an application build",
            "description": {
              "content": "Upload an APK or IPA build to SOFY for testing. The file is sent as multipart/form-data. Returns an `appHash` used to reference the build in subsequent scheduled runs.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "parser-microservice",
                "build-upload"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "userFriendlyBuildName",
                  "value": "<string>",
                  "description": "(Required) Human-readable name for the uploaded build."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "applicationFile",
                  "type": "file",
                  "description": "(Required) The APK or IPA build file. Other extensions are not supported."
                },
                {
                  "key": "ApplicationGUID",
                  "value": "<string>",
                  "type": "text",
                  "description": "Existing application GUID to attach the build to; empty for a new application."
                },
                {
                  "key": "CertificateName",
                  "value": "<string>",
                  "type": "text",
                  "description": "Optional signing certificate name."
                }
              ]
            }
          },
          "response": [
            {
              "id": "e0a6eb5c-f7ac-40d6-bb66-e12c0e73686c",
              "name": "Application uploaded successfully.",
