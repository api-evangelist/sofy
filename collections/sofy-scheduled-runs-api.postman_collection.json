        {
          "id": "569d2604-f4cb-46ac-81b4-d94b3ba732bc",
          "name": "Abort a scheduled run",
          "request": {
            "name": "Abort a scheduled run",
            "description": {
              "content": "Abort an active scheduled run. If testRunGroupId is omitted, all active executions under the scheduled run are aborted.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "scheduler-microservice",
                "public",
                "test-run",
                "abort",
                ":scheduledRunGuid"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "testRunGroupId",
                  "value": "<string>",
                  "description": "Specific test run group to abort; omit to abort all active executions."
                }
