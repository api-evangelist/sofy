              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "appHash",
                  "value": "<string>",
                  "description": "(Required) The application hash value returned by uploadApplication."
                },
                {
                  "disabled": false,
                  "key": "deviceSerials",
                  "value": "<string>",
                  "description": "(Required) Comma-separated list of device identifiers to run against."
                }
