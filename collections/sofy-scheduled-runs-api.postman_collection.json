          "name": "Trigger a scheduled run",
          "request": {
            "name": "Trigger a scheduled run",
            "description": {
              "content": "Queue a previously configured scheduled run for execution against the given build and devices. No request body is required; all parameters are passed via the URL.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "scheduler-microservice",
                "scheduled-runs",
                ":scheduledGUID",
                "execute"
